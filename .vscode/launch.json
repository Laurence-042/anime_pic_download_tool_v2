{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "主程序 (stdin 交互)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "主程序 (读取文件)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["${input:urlFile}"],
            "console": "integratedTerminal"
        },
        {
            "name": "获取 Cookie: Pixiv",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cookie_manager.py",
            "args": ["--site", "pixiv"],
            "console": "integratedTerminal"
        },
        {
            "name": "获取 Cookie: Twitter/X",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cookie_manager.py",
            "args": ["--site", "twitter"],
            "console": "integratedTerminal"
        },
        {
            "name": "Telegram 监听 (持续)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/telegram_source.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Telegram 处理一次 (--once)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/telegram_source.py",
            "args": ["--once"],
            "console": "integratedTerminal"
        },
        {
            "name": "后处理打标 (目录/文件)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/post_process.py",
            "args": ["${input:postProcessTarget}"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "urlFile",
            "type": "promptString",
            "description": "URL 列表文件路径",
            "default": "urls.txt"
        },
        {
            "id": "postProcessTarget",
            "type": "promptString",
            "description": "要处理的图片目录或文件路径",
            "default": "./download"
        }
    ]
}